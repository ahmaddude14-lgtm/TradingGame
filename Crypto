    --bg-card: #1e293b;
    --bg-hover: #334155;
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --success: #10b981;
    --success-hover: #059669;
    --danger: #ef4444;
    --danger-hover: #dc2626;
    --warning: #f59e0b;
    
    /* Text Colors */
    --text-light: #f8fafc;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --text-secondary: #64748b;
    
    /* Borders */
    --border-color: #334155;
    --border-focus: var(--primary);
    
    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 20px rgba(59, 130, 246, 0.3);
    
    /* Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --radius-full: 9999px;
    
    /* Transitions */
    --transition-fast: 0.15s ease;
    --transition-normal: 0.3s ease;
    --transition-slow: 0.5s ease;
    
    /* Z-Index */
    --z-toast: 9999;
    --z-modal: 1000;
    --z-dropdown: 100;
}

/* ===== RESET & BASE ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    height: 100vh;
    overflow: hidden;
    line-height: 1.5;
}

/* ===== UTILITY CLASSES ===== */
.hidden {
    display: none !important;
}

.text-center { text-align: center; }
.text-muted { color: var(--text-muted); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-primary { color: var(--primary); }

/* ===== ANIMATIONS ===== */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideUp {
    from { 
        opacity: 0; 
        transform: translateY(20px); 
    }
    to { 
        opacity: 1; 
        transform: translateY(0); 
    }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}

@keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
}

.fade-in {
    animation: fadeIn var(--transition-normal);
}

.slide-up {
    animation: slideUp var(--transition-normal);
}

.shake {
    animation: shake 0.15s ease-in-out;
}

/* ===== AUTH SECTION ===== */
#auth-section {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background: linear-gradient(135deg, var(--bg-dark) 0%, var(--bg-card) 100%);
    padding: 1rem;
}

.auth-container {
    background-color: var(--bg-card);
    padding: 2rem;
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 400px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-color);
}

.auth-header {
    text-align: center;
    margin-bottom: 2rem;
}

.auth-header h2 {
    color: var(--primary);
    margin-bottom: 0.5rem;
    font-size: 1.75rem;
}

.auth-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
}

/* ===== FORMS ===== */
.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
}

.form-group input {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-dark);
    color: var(--text-light);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    font-size: 1rem;
}

.form-group input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

.form-group input.error {
    border-color: var(--danger);
    animation: shake 0.15s ease-in-out;
}

.form-group input::placeholder {
    color: var(--text-secondary);
}

/* ===== BUTTONS ===== */
.btn {
    width: 100%;
    padding: 0.85rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-primary {
    background-color: var(--primary);
    color: white;
}

.btn-primary:hover:not(:disabled) {
    background-color: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
}

.btn-secondary {
    background-color: var(--bg-hover);
    color: var(--text-light);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover:not(:disabled) {
    background-color: var(--border-color);
}

.btn-success {
    background-color: var(--success);
    color: white;
}

.btn-success:hover:not(:disabled) {
    background-color: var(--success-hover);
    transform: translateY(-1px);
}

.btn-danger {
    background-color: var(--danger);
    color: white;
}

.btn-danger:hover:not(:disabled) {
    background-color: var(--danger-hover);
    transform: translateY(-1px);
}

.btn-buy {
    background-color: var(--success);
    color: white;
    padding: 1rem;
    font-size: 1.1rem;
}

.btn-buy:hover:not(:disabled) {
    background-color: var(--success-hover);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
}

.btn-sell {
    background-color: var(--danger);
    color: white;
    padding: 1rem;
    font-size: 1.1rem;
}

.btn-sell:hover:not(:disabled) {
    background-color: var(--danger-hover);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
}

.btn-logout {
    background: transparent;
    border: 1px solid var(--danger);
    color: var(--danger);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 500;
    transition: all var(--transition-fast);
}

.btn-logout:hover {
    background-color: var(--danger);
    color: white;
}

/* ===== TOGGLE LINK ===== */
.toggle-link {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.toggle-link a {
    color: var(--primary);
    cursor: pointer;
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
}

.toggle-link a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
}

/* ===== DASHBOARD SECTION ===== */
#dashboard-section {
    display: none;
    height: 100vh;
    flex-direction: column;
}

#dashboard-section:not(.hidden) {
    display: flex;
}

/* ===== NAVBAR ===== */
.navbar {
    background-color: var(--bg-card);
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 1rem;
}

.logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.logo span {
    color: var(--text-light);
}

.user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.balance {
    background-color: var(--bg-hover);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    color: var(--success);
    border: 1px solid var(--border-color);
}

.balance-label {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-right: 0.25rem;
}

/* ===== MAIN CONTENT ===== */
.main-content {
    display: flex;
    flex: 1;
    overflow: hidden;
    padding: 1rem;
    gap: 1rem;
}

/* ===== CHART AREA ===== */
.chart-area {
    flex: 3;
    padding: 1rem;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 0.5rem;
}

#product-symbol {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-light);
}

.price-display {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--success);
    transition: color var(--transition-fast);
}

.price-display.negative {
    color: var(--danger);
}

.chart-container {
    position: relative;
    flex: 1;
    min-height: 300px;
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
}

canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
}

canvas.grabbing {
    cursor: grabbing;
}

/* ===== ORDER PANEL ===== */
.order-panel {
    flex: 1;
    min-width: 280px;
    max-width: 350px;
    background-color: var(--bg-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    overflow-y: auto;
}

.panel-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-light);
}

.panel-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
}

.input-group {
    margin-bottom: 1rem;
}

.input-group label {
    display: block;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
}

.input-group input {
    width: 100%;
    padding: 0.85rem;
    background: var(--bg-dark);
    border: 1px solid var(--border-color);
    color: var(--text-light);
    border-radius: var(--radius-md);
    font-size: 1rem;
    transition: border-color var(--transition-fast);
}

.input-group input:focus {
    border-color: var(--primary);
    outline: none;
}

.input-group input:read-only {
    background-color: var(--bg-hover);
    cursor: not-allowed;
}

.trade-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.5rem;
}

.position-info {
    background-color: var(--bg-dark);
    padding: 1rem;
    border-radius: var(--radius-md);
    border-left: 3px solid var(--primary);
}

.position-info p {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
    display: flex;
    justify-content: space-between;
}

.position-info .label {
    color: var(--text-muted);
}

.position-info .value {
    font-weight: 600;
    color: var(--text-light);
}

.position-info.profit .value {
    color: var(--success);
}

.position-info.loss .value {
    color: var(--danger);
}

.deposit-section {
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
}

.deposit-section .input-group {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
}

.deposit-section input {
    flex: 1;
}

.deposit-section .btn {
    width: auto;
    padding: 0.85rem 1.5rem;
    white-space: nowrap;
}

/* ===== ZOOM CONTROLS ===== */
.zoom-controls {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    z-index: 10;
    background: rgba(15, 23, 42, 0.9);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
}

.zoom-btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-color);
    background: var(--bg-dark);
    color: var(--text-main);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
    transition: all var(--transition-fast);
    line-height: 1;
}

.zoom-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
    transform: scale(1.1);
}

.zoom-btn:active {
    transform: scale(0.95);
}

#zoom-indicator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
}

.zoom-bar {
    width: 80px;
    height: 4px;
    background: var(--border-color);
    border-radius: var(--radius-full);
    overflow: hidden;
    position: relative;
}

.zoom-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--success));
    transition: width 0.2s ease;
    border-radius: var(--radius-full);
}

/* Tooltip for zoom */
.zoom-hint {
    position: absolute;
    top: -45px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-card);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
    border: 1px solid var(--border-color);
}

.zoom-controls:hover .zoom-hint {
    opacity: 1;
}

/* ===== PRODUCT SELECTION SECTION ===== */
#product-section {
    display: none;
    height: 100vh;
    overflow-y: auto;
    padding: 2rem;
}

#product-section:not(.hidden) {
    display: block;
}

.section-header {
    text-align: center;
    margin-bottom: 2rem;
}

.section-header h2 {
    font-size: 1.75rem;
    color: var(--text-light);
    margin-bottom: 0.5rem;
}

.section-header .text-muted {
    font-size: 1rem;
}

/* 📦 Product Grid */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.product-card {
    background: var(--bg-card);
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    padding: 1.5rem 1rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    transition: background var(--transition-fast);
}

.product-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.product-card:hover::before {
    background: var(--primary);
}

.product-card.active {
    border-color: var(--success);
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(16, 185, 129, 0.1) 100%);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
}

.product-card.active::before {
    background: var(--success);
}

.product-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    display: block;
    line-height: 1;
}

.product-name {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
    color: var(--text-light);
}

.product-symbol {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
}

.product-price {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--success);
    margin: 0.5rem 0;
}

.product-change {
    font-size: 0.9rem;
    font-weight: 500;
}

.product-change.positive { 
    color: var(--success); 
}

.product-change.negative { 
    color: var(--danger); 
}

/* Loading state for product cards */
.product-card.loading .product-price {
    opacity: 0.6;
    animation: pulse 1.5s infinite;
}

/* Back button styling */
#back-to-products {
    display: block;
    margin: 2rem auto;
    max-width: 250px;
}

/* ===== NOTIFICATIONS / TOAST ===== */
.toast {
    position: fixed; 
    top: 20px; 
    right: 20px;
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-dark) 100%);
    border-left: 4px solid; 
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md); 
    color: var(--text-light); 
    font-weight: 500;
    transform: translateX(120%); 
    transition: transform var(--transition-normal);
    z-index: var(--z-toast); 
    min-width: 280px; 
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
}

.toast-success { 
    border-color: var(--success); 
}

.toast-error { 
    border-color: var(--danger); 
}

.toast-info { 
    border-color: var(--primary); 
}

.toast.toast-show { 
    transform: translateX(0); 
}

.toast-icon { 
    margin-right: 0.75rem; 
    font-size: 1.25rem; 
}

.toast-message { 
    font-size: 0.9rem; 
    line-height: 1.4; 
}

/* ===== TIMER INDICATOR ===== */
.timer-indicator {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.95);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 0.85rem;
    z-index: 10;
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.timer-indicator::before {
    content: '●';
    color: var(--success);
    animation: pulse 1s infinite;
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 1024px) {
    .main-content {
        flex-direction: column;
    }
    
    .chart-area {
        border-right: none;
        border-bottom: 1px solid var(--border-color);
        min-height: 400px;
    }
    
    .order-panel {
        max-width: 100%;
        min-width: auto;
    }
}

@media (max-width: 768px) {
    .auth-container {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .navbar {
        padding: 1rem;
        flex-direction: column;
        text-align: center;
    }
    
    .user-info {
        justify-content: center;
    }
    
    .chart-header {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    
    .product-card {
        padding: 1rem 0.75rem;
    }
    
    .product-icon {
        font-size: 2rem;
    }
    
    .product-name {
        font-size: 1rem;
    }
    
    .product-price {
        font-size: 1.1rem;
    }
    
    .trade-buttons {
        grid-template-columns: 1fr;
    }
    
    .zoom-controls {
        bottom: 0.75rem;
        padding: 0.4rem 0.75rem;
    }
    
    .zoom-btn {
        width: 32px;
        height: 32px;
        font-size: 1rem;
    }
    
    #zoom-indicator {
        font-size: 0.8rem;
    }
    
    .zoom-bar {
        width: 60px;
    }
}

@media (max-width: 480px) {
    .product-grid {
        grid-template-columns: 1fr;
    }
    
    .auth-header h2 {
        font-size: 1.5rem;
    }
    
    .balance {
        font-size: 0.9rem;
        padding: 0.4rem 1rem;
    }
    
    .price-display {
        font-size: 1.4rem;
    }
    
    #product-symbol {
        font-size: 1.25rem;
    }
}

/* ===== SCROLLBAR CUSTOMIZATION ===== */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
}

/* ===== FOCUS ACCESSIBILITY ===== */
button:focus-visible,
input:focus-visible,
a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
